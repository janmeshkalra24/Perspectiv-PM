# API Configuration
REPLICATE_API_TOKEN=your_replicate_api_token_here
DEFAULT_MODEL_TYPE=llava  # or other supported models

# Frame Buffer Configuration
FRAME_BUFFER_TYPE=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Processing Configuration
MAX_FRAME_HISTORY=1000
FRAME_PROCESSING_INTERVAL=0.1  # seconds
CONTEXT_RETENTION_PERIOD=3600  # seconds

# API Retry Configuration
API_MAX_RETRIES=3
API_TIMEOUT=30.0  # seconds

# Logging
LOG_LEVEL=INFO
LOG_FILE=screen_understanding.log

# Port Configuration
PORT=8000
GOOGLE_API_KEY=your_google_api_key 